# === PRODUCTION ENVIRONMENT ===
NODE_ENV=production

# AWS Configuration
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=CHANGE_ME_USE_IAM_ROLE_PREFERRED
AWS_SECRET_ACCESS_KEY=CHANGE_ME_USE_IAM_ROLE_PREFERRED

# DynamoDB Tables
DYNAMODB_QUERIES_TABLE=wpcs-queries
DYNAMODB_ADMIN_TABLE=wpcs-admin-users
DYNAMODB_PROJECTS_TABLE=wpcs-projects
DYNAMODB_NEWSLETTERS_TABLE=wpcs-newsletters
DYNAMODB_NEWS_TABLE=wpcs-news

# S3 Configuration
S3_BUCKET_NAME=west-palm-files
S3_UPLOAD_FOLDER=attachments

# JWT Configuration - GENERATE STRONG SECRET: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_64_CHAR_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# CORS Configuration - Production URLs
FRONTEND_URL=https://westpalmcs.com
ADMIN_PANEL_URL=https://admin.westpalmcs.com

# File Upload Configuration
MAX_FILE_SIZE=157286400
ALLOWED_FILE_TYPES=.pdf,.zip,.docx,.doc,.jpg,.jpeg,.png,.jfif,.webp,.gif,.bmp,.svg,.mp4,.mov,.avi,.webm,.mkv

# Server Configuration
PORT=3001
