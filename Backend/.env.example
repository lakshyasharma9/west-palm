# AWS Configuration
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# DynamoDB Tables
DYNAMODB_QUERIES_TABLE=wpcs-queries
DYNAMODB_ADMIN_TABLE=wpcs-admin-users
DYNAMODB_PROJECTS_TABLE=wpcs-projects
DYNAMODB_NEWSLETTERS_TABLE=wpcs-newsletters

# S3 Configuration
S3_BUCKET_NAME=west-palm-files
S3_UPLOAD_FOLDER=attachments

# JWT Configuration
JWT_SECRET=wpcs_super_secret_key_change_in_production_2024
JWT_EXPIRES_IN=7d

# CORS Configuration
FRONTEND_URL=http://localhost:3000
ADMIN_PANEL_URL=http://localhost:8080

# File Upload Configuration
MAX_FILE_SIZE=26214400
ALLOWED_FILE_TYPES=.pdf,.zip,.docx,.doc,.jpg,.jpeg,.png

# Local Server Configuration
PORT=3001

# Email Configuration (Resend - https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
